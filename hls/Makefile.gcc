# Makefile.gcc -- C simulation WITHOUT Vitis HLS (plain g++ + the open-source
# AMD arbitrary-precision headers: https://github.com/Xilinx/HLS_arbitrary_Precision_Types)
#
#   git clone https://github.com/Xilinx/HLS_arbitrary_Precision_Types.git ../build/hlsap
#   make -f Makefile.gcc run                     # unit tests
#   make -f Makefile.gcc run-full                # + full AlexNet vs golden vectors
#
# This is a convenience/CI path.  The authoritative flow is scripts/run_hls.tcl
# in Vitis HLS 2024.2 (which ships its own ap_int.h).
AP_INC ?= ../build/hlsap/include
GOLDEN ?= ../build/deploy/golden
CXX    ?= g++
CXXFLAGS = -O2 -std=c++14 -Wall -Wno-unknown-pragmas -Wno-unused-function -Iinclude -I$(AP_INC)
SRCS = src/alexnet_accel.cpp src/conv_engine.cpp src/fc_engine.cpp src/load_store.cpp \
       testbench/tb_alexnet_accel.cpp

csim_gcc: $(SRCS) include/*.h
	$(CXX) $(CXXFLAGS) $(SRCS) -o $@

run: csim_gcc
	./csim_gcc

run-full: csim_gcc
	ALEXNET_GOLDEN=$(GOLDEN) ./csim_gcc

clean:
	rm -f csim_gcc
